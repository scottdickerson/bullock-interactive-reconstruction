---
import Layout from '../../layouts/Layout.astro';
import DetailScreen from '../../screens/DetailScreen';
import { selectScreenData } from '../../data/content';

export function getStaticPaths() {
  return selectScreenData.categories.map(category => {
    const categorySlug = category.name
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/\//g, '-');
    
    return {
      params: { category: categorySlug },
    };
  });
}

const { category } = Astro.params;
---

<Layout title="Reconstruction Era Texans - Details" category={category}>
  <DetailScreen category={category || 'agriculture'} client:load />
</Layout>

