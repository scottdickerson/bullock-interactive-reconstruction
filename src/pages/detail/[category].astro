---
import Layout from '../../layouts/Layout.astro';
import DetailScreen from '../../screens/DetailScreen';
import { Category as CategoryEnum, categoryToSlug } from '../../utils/categories';

export function getStaticPaths() {
  return Object.values(CategoryEnum).map(category => {
    return {
      params: { category: categoryToSlug(category) },
    };
  });
}

const { category } = Astro.params;
---

<Layout title="Reconstruction Era Texans - Details" category={category}>
  <DetailScreen category={category || 'agriculture'} client:load />
</Layout>

