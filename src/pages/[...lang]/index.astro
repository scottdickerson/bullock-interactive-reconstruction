---
import Layout from '../../layouts/Layout.astro';
import Pullscreen from '../../screens/Pullscreen';
import I18nProvider from '../../components/I18nProvider';
import { getServerTranslation } from '../../lib/i18n-server';

export function getStaticPaths() {
    return [
    { params: { lang: undefined } },
      // English (default) - no lang prefix
      { params: {lang: 'en' as const} },
    // Spanish - with 'es' prefix
    { params: { lang: 'es' as const } },
   
  ];
}

// Extract lang from params - if lang array exists and first element is 'es', use Spanish
const lang = Astro.params.lang === 'es' ? 'es' : 'en';

// Get server-side translations for this language
const t = getServerTranslation(lang);
const translations = {
  pullscreen: {
    title: t('pullscreen.title'),
    subtitle: t('pullscreen.subtitle'),
    description: t('pullscreen.description'),
  },
  common: {
    start: t('common.start'),
  },
};
---

<Layout title="Recounting Reconstruction" lang={lang}>
  <I18nProvider lang={lang} client:load>
    <Pullscreen translations={translations} lang={lang} client:load />
  </I18nProvider>
</Layout>

 