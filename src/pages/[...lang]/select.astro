---
import Layout from '../../layouts/Layout.astro';
import SelectScreen from '../../screens/SelectScreen';
import I18nProvider from '../../components/I18nProvider';
import { getServerTranslation } from '../../lib/i18n-server';
import { getSelectScreenData } from '../../data/content';

export function getStaticPaths() {
  return [
    // English (default) - no lang prefix
    { params: { lang: undefined } },
    { params: {lang: 'en' as const} },
    // Spanish - with 'es' prefix
    { params: { lang: 'es' as const } },
  ];
}

// Extract lang from params - if lang is 'es', use Spanish, otherwise English
const lang = Astro.params.lang === 'es' ? 'es' : 'en';

// Get server-side translations for this language
const t = getServerTranslation(lang);
const selectScreenData = getSelectScreenData(t);
---

<Layout title="Reconstruction Era Texans - Select Category" lang={lang}>
  <I18nProvider lang={lang} client:load>
    <SelectScreen initialData={selectScreenData} client:load />
  </I18nProvider>
</Layout>

