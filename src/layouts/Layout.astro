---
import Analytics from '../components/Analytics';
import NavigationButtonsWrapper from '../components/NavigationButtonsWrapper';
import InactivityModalWrapper from '../components/InactivityModalWrapper';
import I18nProvider from '../components/I18nProvider';
import { slugToCategory, getCategoryBackground } from '../utils/categories';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  pathname?: string;
  category?: string;
  lang?: 'en' | 'es';
}

const { title = 'Bullock Interactive Reconstruction', category, lang = 'en' } = Astro.props;
const pathname = Astro.url.pathname;

// Get background image URL
const categoryEnum = category ? slugToCategory(category) : null;
const backgroundImage = categoryEnum
  ? `/category-background/${getCategoryBackground(categoryEnum)}`
  : '/PurpleBackground.gif';

// Get GA tracking ID from environment variable
const gaTrackingId = import.meta.env.PUBLIC_GA_TRACKING_ID;
console.log(gaTrackingId);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Recounting Reconstruction - Bullock Interactive" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {gaTrackingId && (
      <>
        {/* Google tag (gtag.js) */}
        <script
          async
          is:inline
          src={`https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`}
        ></script>
        <script
          is:inline
          set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());`}
        ></script>
      </>
    )}
  </head>
  <body >
    <main class="px-32 h-svh text-pretty overflow-hidden">
    <Analytics client:load />
    <ClientRouter />
    <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={{ backgroundImage: `url(${backgroundImage})` }}
  ></div>
    <div class="[view-transition-name:content] relative h-full">
      <slot />
      <I18nProvider lang={lang} client:load>
        <NavigationButtonsWrapper pathname={pathname} lang={lang} client:load />
      </I18nProvider>
      <InactivityModalWrapper pathname={pathname}  client:load />
    </div>
  </main>
  </body>
</html>

<style is:global>
  @import '../index.css';
</style>

