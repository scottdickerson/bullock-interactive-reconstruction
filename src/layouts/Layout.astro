---
import Analytics from '../components/Analytics';
interface Props {
  title?: string;
  pathname?: string;
}

const { title = 'Bullock Interactive Reconstruction'} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Recounting Reconstruction - Bullock Interactive" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Analytics client:load />
    <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={{ backgroundImage: `url(/background.png)` }}
  ></div>
    <div class="[view-transition-name:content]">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../index.css';
</style>

